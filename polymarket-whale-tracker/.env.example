# Blockchain (Alchemy Polygon endpoints)
ALCHEMY_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_HTTP_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (connection string with TLS)
REDIS_URL=rediss://default:password@host:6379

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# App Configuration
MIN_DEPOSIT_AMOUNT=9000
NODE_ENV=development
